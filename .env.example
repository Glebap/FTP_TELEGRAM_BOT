# ---- Telegram ----
# Get the token from @BotFather
BOT_TOKEN=123456:ABC-DEF-your-token-here

# Comma-separated Telegram IDs allowed to run /admin
ADMIN_IDS=

# ---- Database ----
# SQLite (default, no extra services required)
DATABASE_URL="file:./dev.db"
# PostgreSQL (switch prisma/schema.prisma provider to "postgresql" first)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sport_partner?schema=public"

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# Ping every ADMIN_IDS chat when someone finishes registration
ADMIN_NOTIFY=true

# ---- "New players in your city" digest ----
# Set to false to switch the twice-a-day notification off entirely
DIGEST_ENABLED=true
# Local times of day, comma separated
DIGEST_TIMES=10:00,19:00
# IANA timezone the times above are interpreted in
DIGEST_TIMEZONE=Europe/Chisinau

# ---- Limits (spam protection) ----
SEARCH_LIMIT_PER_MINUTE=60
CONTACT_LIMIT_PER_MINUTE=5
CONTACT_LIMIT_PER_DAY=30
